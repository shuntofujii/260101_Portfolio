# Cloudflare R2（S3 互換 API）
# 既存バケット名は assets。Account ID は Cloudflare ダッシュボードの URL から確認可
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=assets

# 公開 URL（省略時: constants.js の baseAssetsUrl）
R2_PUBLIC_BASE_URL=https://assets.shuntofujii.com

# GitHub Contents API（--github-commit 時のみ）
GITHUB_TOKEN=
GITHUB_OWNER=shuntofujii
GITHUB_REPO=260101_Portfolio
GITHUB_BRANCH=main
